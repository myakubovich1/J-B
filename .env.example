# Web and worker: Node 24+. Local mode has real persisted accounts and no seeded data.
APP_MODE=local
APP_URL=http://127.0.0.1:3000
DATA_DIR=.data
COOKIE_SECURE=false
ENABLE_TEST_EMPLOYER=true

# Production: APP_MODE=supabase; ENABLE_TEST_EMPLOYER=false; HTTPS APP_URL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=career-artifacts

# Model names are explicit, configurable, and never silently substituted.
OPENAI_API_KEY=
OPENAI_MODEL_EXTRACTION=
OPENAI_MODEL_CHAT=
MODEL_INPUT_USD_PER_MILLION=
MODEL_OUTPUT_USD_PER_MILLION=
MAX_MODEL_OPERATIONS_PER_MONTH=500

# Worker controls. Emergency stop prevents new side effects; sent submits require reconciliation.
WORKER_CONCURRENCY=1
WORKER_POLL_MS=1500
WORKER_LEASE_SECONDS=600
MAX_JOB_ATTEMPTS=3
MAX_BROWSER_RUNTIME_MS=180000
PER_USER_MONTHLY_BUDGET_USD=100
EXPENSIVE_APPLICATION_ALERT_USD=5
MONTHLY_BUDGET_ALERT_RATIO=0.8
GLOBAL_EMERGENCY_STOP=false
MAX_DISCOVERY_JOBS_PER_RUN=10
DISCOVERY_INTERVAL_MINUTES=60
EMAIL_POLL_INTERVAL_MINUTES=5
MAX_RESUMES_PER_MONTH=300

# Default local compiler processes trusted, escaped templates only. Custom/production use Docker.
LATEX_MODE=local
# Compiler deadline (bounded 5000-120000 ms).
LATEX_TIMEOUT_MS=45000
TECTONIC_BIN=tectonic
LATEX_DOCKER_IMAGE=career-latex:local
RESUME_MAX_PAGES=1

# Empty allowlist disables live browser execution. Add only permitted ATS domains.
BROWSER_ALLOWED_DOMAINS=
BROWSER_RESOURCE_DOMAINS=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSER_USD_PER_MINUTE=
# Self-hosted production browsers must use a network-layer egress-restricted proxy.
BROWSER_EGRESS_PROXY_URL=

# GitHub OAuth callback: APP_URL/api/integrations/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Gmail callback: APP_URL/api/integrations/callback/gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Enable only after provider approval or for explicitly approved Google test users.
EMAIL_OAUTH_APPROVED=false
# Microsoft callback: APP_URL/api/integrations/callback/outlook
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Stripe secrets and recurring price IDs. Do not use live keys in development.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_AUTONOMOUS_PRICE_ID=
PLAN_FREE_LIMIT=5
PLAN_PRO_LIMIT=100
PLAN_AUTONOMOUS_LIMIT=300
PLAN_PRO_MONTHLY_USD=39
PLAN_AUTONOMOUS_MONTHLY_USD=199
ADMIN_USER_IDS=

# Operations. Alerts POST JSON (Slack-compatible "text") to the webhook, signed with
# HMAC-SHA256 over "<X-Waypoint-Timestamp>.<body>" in X-Waypoint-Signature.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
# development | staging | production. Live Stripe keys fail readiness outside production.
DEPLOYMENT_ENVIRONMENT=development
# Bearer token that unlocks readiness details at /api/ready.
HEALTH_CHECK_TOKEN=
# Worker retention pass interval (orphaned artifacts, expired operational rows). 0 disables.
RETENTION_INTERVAL_HOURS=6
APP_VERSION=
# Shown in Settings for data and privacy questions.
NEXT_PUBLIC_SUPPORT_EMAIL=
