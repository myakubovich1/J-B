{
  "name": "jasteriskb",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "worker": "tsx --env-file-if-exists=.env.local workers/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node --env-file-if-exists=.env.local node_modules/playwright/cli.js test",
    "db:migrate": "supabase migration up --local",
    "check": "npm run typecheck && npm test && npm run build",
    "test:e2e:local": "node scripts/test-e2e.mjs",
    "db:reset:local": "supabase db reset --local",
    "format": "prettier --write src workers tests e2e scripts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "16.4.3",
    "openai": "7.45.1",
    "playwright": "^1.58.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^20.0.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.13",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "prettier": "3.9.10",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
